{
	"name": "@codeeditorland/dtdl",
	"displayName": "DTDL",
	"version": "0.0.1",
	"private": false,
	"description": "This extension provides syntax highlighting to read and edit JSON documents using the Digital Twins Definition Language",
	"keywords": [
		"codeeditorland",
		"land",
		"playform"
	],
	"homepage": "HTTPS://GitHub.Com/CodeEditorLand/LandDtdl#readme",
	"bugs": {
		"url": "HTTPS://GitHub.Com/CodeEditorLand/LandDtdl/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+HTTPS://github.com/CodeEditorLand/LandDtdl.git"
	},
	"license": "SEE LICENSE IN LICENSE",
	"author": {
		"name": "Source 🖋️ Open 👐🏻",
		"email": "Source/Open@Editor.Land",
		"url": "HTTPS://Editor.Land"
	},
	"type": "module",
	"main": "./dist/extension",
	"scripts": {
		"compile": "tsc -p ./",
		"prepublishOnly": "Build 'Source/**/*.ts'",
		"test:coverage": "jest --coverage",
		"webpack": "webpack --mode development"
	},
	"contributes": {
		"commands": [
			{
				"category": "DTDL",
				"command": "vscode-dtdl.createInterface",
				"title": "Create Interface"
			}
		],
		"grammars": [
			{
				"language": "colorized-channel",
				"path": "./syntaxes/colorized.channel.tmLanguage",
				"scopeName": "text.channel.colorized"
			}
		],
		"jsonValidation": [
			{
				"fileMatch": "*.json",
				"url": "./resources/jsonSchema.json"
			}
		],
		"languages": [
			{
				"id": "colorized-channel",
				"mimetypes": [
					"text/x-code-output"
				]
			}
		],
		"snippets": [
			{
				"language": "json",
				"path": "./snippets/snippets.json"
			}
		]
	},
	"activationEvents": [
		"onCommand:vscode-dtdl.createInterface",
		"onLanguage:json",
		"workspaceContains:**/*.json"
	],
	"dependencies": {
		"dtdl-language-server": "0.6.1",
		"fs-extra": "11.3.0"
	},
	"devDependencies": {
		"@playform/build": "0.2.1",
		"@types/fs-extra": "11.0.4",
		"@types/glob": "8.1.0",
		"@types/node": "22.14.0",
		"glob": "11.0.1",
		"ts-loader": "9.5.2"
	},
	"publishConfig": {
		"access": "public"
	},
	"icon": "logo.png",
	"aiKey": "[AIKEY PLACEHOLDER]"
}
